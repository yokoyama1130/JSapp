<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>キャンプ場の編集</title>
</head>
<body>
    <h1>キャンプ場の編集</h1>
    <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="post">
        <div>
            <label for="title">タイトル</label>
            <input type="text" name="campground[title]" id="title" value="<%= campground.title %>" placeholder="タイトル">
        </div>
        <div>
            <label for="location">場所</label>
            <input type="text" name="campground[location]" id="location" value="<%= campground.location %>" placeholder="場所">
        </div>
        <button>更新する</button>
    </form>
    <a href="/campgrounds">戻る</a>
    
</body>
</html>